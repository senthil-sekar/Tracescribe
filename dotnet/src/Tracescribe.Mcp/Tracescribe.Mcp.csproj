<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>MCP server and CLI that give AI agents triage digests of traces from Jaeger, Grafana Tempo or OTLP/JSON files.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tracescribe-mcp</ToolCommandName>
    <PackageId>Tracescribe.Mcp</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tracescribe.Query\Tracescribe.Query.csproj" />
  </ItemGroup>
</Project>
